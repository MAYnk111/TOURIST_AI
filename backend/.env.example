# ==========================================
# AI TOURIST BACKEND CONFIGURATION
# ==========================================

# Server Settings
DEBUG=True
PORT=8000

# Hugging Face Settings (Open-weight LLM)
# Get your token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

# Firebase Admin SDK Configuration
# Download service account private key JSON from Firebase Console:
# Project Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=ai-tourist-app

# Open-Data Destination Providers (Free / No Paid API Keys Required)
# 1. OpenStreetMap Overpass API (Attraction & POI Discovery)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_BACKUP_URL=https://overpass.kumi.systems/api/interpreter

# 2. Wikimedia Commons API (Open-License Destination Photography)
WIKIMEDIA_COMMONS_URL=https://commons.wikimedia.org/w/api.php

# 3. Open Source Routing Machine (OSRM Transit & Routing)
OSRM_ROUTING_URL=https://router.project-osrm.org

# Optional / Community
OPENTRIPMAP_API_KEY=
