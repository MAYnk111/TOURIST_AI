rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read & write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User private subcollections (saved_places, preferences)
      match /saved_places/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Trips collection: authenticated users can create trips, and only owners can read/update/delete
    match /trips/{tripId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // Public verified destinations and attractions (read-only for all clients)
    match /destinations/{destId} {
      allow read: if true;
      allow write: if false; // Admin backend only
      
      match /attractions/{attractionId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
